# Server-only Gemini API key. Never expose this to the browser or log it.
# Required for live extraction. Recorded fixture mode works without a key.
# Copy this file to .env.local (gitignored) and fill in the value.
GEMINI_KEY=

# The React SPA (npm run dev) proxies /api to the backend (npm run dev:server).
# Recorded extraction needs dev:server running; it does not need GEMINI_KEY.
# The client bundle never reads GEMINI_KEY or any VITE_* secret.
