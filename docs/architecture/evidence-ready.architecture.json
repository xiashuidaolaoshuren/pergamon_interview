      "dot": "cyan",
      "title": "Single TypeScript repo",
      "items": [
        "Vite SPA for the UI; same-repo server for document and Gemini routes",
        "No separate API service or database"
      ]
    },
    {
      "dot": "emerald",
      "title": "Control plane",
      "items": [
